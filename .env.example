# =============================================================================
# db-sync-platform 生产环境变量样例
# 用法：复制为 .env（或由容器编排注入），按实际环境改值；.env 已被 .gitignore 忽略。
# 实现以 application.yml / application-h2.yml 为准，见 docs/00-后端功能总览.md §10、§11.3。
# =============================================================================

# ---- 必填 ------------------------------------------------------------------
# 主密钥：≥32 字符随机值，启动强校验；留空启动失败。轮换时配合 previous-master-key。
DBSYNC_MASTER_KEY=please-replace-with-a-32-bytes-random-secret
DBSYNC_PREVIOUS_MASTER_KEY=
DBSYNC_KEY_VERSION=1

# 元数据库：默认档是本地 H2 文件库，不支持多实例；生产必须指向共享 MySQL 8。
DBSYNC_META_URL=jdbc:mysql://mysql:3306/dbsync_meta?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DBSYNC_META_USER=dbsync
DBSYNC_META_PASSWORD=change-me

# ---- 实例 / 端口 ------------------------------------------------------------
DBSYNC_INSTANCE_HOST=
DBSYNC_PORT=8080

# ---- 认证与会话 -------------------------------------------------------------
# 令牌硬 TTL（分钟，默认 480=8h，不滑动）；SDK 路由快照轮询需可刷新令牌，见 §6.8。
DBSYNC_AUTH_TOKEN_TTL_MINUTES=480
# 空闲超时（分钟，0=禁用）
DBSYNC_AUTH_IDLE_TIMEOUT_MINUTES=30

# ---- 告警（两层开关，见 §11.3） ----------------------------------------------
# 渠道总开关，逗号分隔；默认仅 LOG，配了 WEBHOOK/EMAIL 但不在此列出则永远不会下发。
DBSYNC_ALERT_CHANNELS=LOG,EMAIL,WEBHOOK
DBSYNC_ALERT_WEBHOOK=https://your-alert-gateway/hook
# 第二层：mail.enabled 必须为 true，且 HOST/FROM/RECIPIENTS 齐全才会真正发信。
DBSYNC_ALERT_MAIL_ENABLED=true
DBSYNC_ALERT_MAIL_HOST=smtp.example.com
DBSYNC_ALERT_MAIL_PORT=587
DBSYNC_ALERT_MAIL_USERNAME=
DBSYNC_ALERT_MAIL_PASSWORD=
DBSYNC_ALERT_MAIL_FROM=dbsync-alert@example.com
DBSYNC_ALERT_MAIL_STARTTLS=true
DBSYNC_ALERT_MAIL_SSL=false
DBSYNC_ALERT_MAIL_CONNECT_TIMEOUT_MS=5000
DBSYNC_ALERT_MAIL_RECIPIENTS=ops@example.com

# ---- 任务 / 报告 / 抢占 ------------------------------------------------------
DBSYNC_CLAIM_STRATEGY=SKIP_LOCKED
DBSYNC_REPORT_DIR=reports

# ---- CORS（默认仅本机；前后端分离部署时按需放行，逗号分隔） -------------------
# 对应配置键 dbsync.cors.allowed-origins，默认值 http://localhost:*,http://127.0.0.1:*
DBSYNC_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---- 可选 JDBC 驱动 ----------------------------------------------------------
# Oracle / DM8 / DB2 驱动因授权不随仓库分发，放入 lib/ 后由启动脚本加入 classpath，
# 详见 lib/README.md。
