{
  "name": "db-sync-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "异构数据库同步与迁移平台 - 运维控制台",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-mock",
    "preview": "vite preview",
    "build:server": "tsc --noEmit && vite build --outDir ../db-sync-server/src/main/resources/static --emptyOutDir"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
